+
+def test_all_volume_and_value_missing_fails_closed_for_every_dependent_output():
+    data = rows(list(range(1, 260)), volume=None, value=None)
+    result = MarketEngine().analyze_market(1, AS_OF, data)
+    ind = result.indicators
